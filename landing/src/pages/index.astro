---
// index.astro - packwing's landing page
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Safety from '../components/Safety.astro';
import Formats from '../components/Formats.astro';
import Storages from '../components/Storages.astro';
import CommandLine from '../components/CommandLine.astro';
import Organizations from '../components/Organizations.astro';
import FAQ from '../components/FAQ.astro';
import GetStarted from '../components/GetStarted.astro';
import { faq } from '../data/faq';
import { SITE_URL, GITHUB_URL } from '../data/site';

const pageTitle = 'packwing — the file archiver that opens archives safely';
const pageDescription =
  'A free, open source file archiver for macOS, Windows and Linux, built in Rust. Opens ZIP, RAR, 7z, tar, ISO and age files safely, writes ZIP, 7z and tar with AES-256, and browses S3, WebDAV and SFTP. With pkw for the command line.';
const siteUrl = `${SITE_URL}/`;
const ogImage = new URL('/og-image.png', siteUrl).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'packwing',
  url: siteUrl,
  description: pageDescription,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'macOS, Windows, Linux',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  image: ogImage,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  sameAs: [GITHUB_URL],
};
const faqData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path="/"
  keywords="file archiver, unzip, unrar, 7z, zip, tar, zstd, age encryption, archive extractor, 7-Zip alternative, WinRAR alternative, open source, Rust, packwing"
  jsonLd={[structuredData, faqData]}
>
  <Hero />
  <Features />
  <Safety />
  <Formats />
  <Storages />
  <CommandLine />
  <Organizations />
  <FAQ />
  <GetStarted />
</BaseLayout>
