---
// Shot.astro - a screenshot of packwing, in a window's frame. The pictures are
// the app's own (packwing's `cargo test --features shots`), dark, 1600×1000.
interface Props {
  name: string;
  alt: string;
  /** The first screen's picture: loaded at once. */
  eager?: boolean;
}

const { name, alt, eager = false } = Astro.props;
---

<figure class="shot">
  <img
    src={`/shots/${name}.webp`}
    width="1600"
    height="1000"
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : 'auto'}
  />
</figure>

<style>
  .shot {
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--border-card);
    background: #0e1318;
    box-shadow:
      0 30px 80px -30px rgba(0, 0, 0, 0.9),
      0 0 0 1px rgba(255, 255, 255, 0.02),
      0 0 60px -20px var(--accent-glow);
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
